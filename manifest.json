{
  "name": "縦書きエディター",
  "short_name": "縦書き",
  "description": "日本語縦書きテキストエディター",
  "start_url": "./index.html",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#2c2416",
  "background_color": "#c8b89a",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [".txt"],
        "text/markdown": [".md"]
      }
    }
  ]
}
